{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "postgres"
  },
  "Jwt": {
    "Issuer": "https://eule.adacreative.net",
    "Audience": "eule-desktop",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "OpenAI": {
    "Model": "gpt-6-luna",
    "ReasoningEffort": "none",
    "TimeoutSeconds": 12
  },
  "Limits": {
    "DictationsPerMonth": 100
  }
}
