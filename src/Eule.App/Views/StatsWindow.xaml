<ui:FluentWindow x:Class="Eule.App.Views.StatsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:Eule.App.Controls"
                 Title="Eule · İstatistik" Width="660" Height="860" MinWidth="560" MinHeight="480"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round" FontFamily="{StaticResource Eule.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="İstatistik" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
            <StackPanel>

                <!-- Headline numbers -->
                <UniformGrid x:Name="Tiles" Columns="3" Margin="0,8,0,0" />

                <!-- Last 14 days -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Son 14 gün" Margin="2,28,0,2" />
                <TextBlock Style="{StaticResource Eule.Caption}" FontSize="12" Margin="2,0,0,12" Text="Günlük oturma süresi" />
                <Border Style="{StaticResource Eule.Row}" Padding="16,18,16,12">
                    <StackPanel>
                        <Grid x:Name="BarChart" Height="190" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Eule.Ink}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Eule.Caption}" Text="hedef tuttu" Margin="6,0,14,0" />
                            <Ellipse Width="7" Height="7" Stroke="{DynamicResource Eule.Muted}" StrokeThickness="1.2" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Eule.Caption}" Text="tutmadı" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Weekly rhythm heat map -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Haftanın ritmi" Margin="2,28,0,2" />
                <TextBlock Style="{StaticResource Eule.Caption}" FontSize="12" Margin="2,0,0,12"
                           Text="Son 4 haftada, saat başına ortalama oturma" />
                <Border Style="{StaticResource Eule.Row}" Padding="16,16,16,14">
                    <StackPanel>
                        <Grid x:Name="Heatmap" />
                        <StackPanel x:Name="HeatLegend" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Insights -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Eule ne fark etti?" Margin="2,28,0,10" />
                <StackPanel x:Name="InsightList" />

                <!-- Export -->
                <DockPanel Margin="2,26,0,0">
                    <ui:Button x:Name="ExportButton" DockPanel.Dock="Right" Appearance="Secondary" Content="CSV olarak dışa aktar" />
                    <TextBlock x:Name="ExportText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"
                               Foreground="{DynamicResource Eule.Muted}"
                               Text="Tüm günlerin tablosu; Excel'de doğrudan açılır." />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
