<Window x:Class="Eule.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Eule.App.Controls"
        Title="Eule"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource Eule.Font}">

    <Border x:Name="Card" Margin="16" CornerRadius="30" Padding="7,7,12,7"
            Background="{DynamicResource Eule.Raised}" BorderBrush="{DynamicResource Eule.Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="5" Direction="270"
                              Color="{DynamicResource Eule.ShadowColor}" Opacity="{DynamicResource Eule.ShadowOpacity}" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <c:OwlView x:Name="Owl" Width="46" Height="46" />

                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" MinWidth="74">
                    <TextBlock x:Name="Caption" Style="{StaticResource Eule.Caption}" Text="molaya" />
                    <TextBlock x:Name="Time" Style="{StaticResource Eule.Clock}" FontSize="24" Margin="0,-3,0,0" Text="30:00" />
                </StackPanel>

                <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                    <Button x:Name="PauseButton" Style="{StaticResource Eule.IconButton}" Content="&#xE769;" ToolTip="Duraklat" />
                    <Button x:Name="HideButton" Style="{StaticResource Eule.IconButton}" Content="&#xE711;" ToolTip="Gizle (tepsiden geri açılır)" />
                </StackPanel>
            </Grid>

            <!-- The widget itself is the notification: it grows a little and asks. -->
            <StackPanel x:Name="Prompt" Visibility="Collapsed" Margin="6,10,0,2" MaxWidth="250" HorizontalAlignment="Left">
                <TextBlock x:Name="PromptText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Eule.Ink}" />
                <WrapPanel x:Name="PromptButtons" Margin="0,10,0,0">
                    <Button x:Name="AcceptButton" Style="{StaticResource Eule.PillPrimary}" Content="Kalktım" />
                    <Button x:Name="SnoozeButton" Style="{StaticResource Eule.Pill}" Content="5 dk sonra" />
                    <Button x:Name="SkipButton" Style="{StaticResource Eule.Pill}" Content="Atla" />
                    <Button x:Name="StartButton" Style="{StaticResource Eule.PillPrimary}" Content="Devam et" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
