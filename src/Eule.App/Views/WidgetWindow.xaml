<Window x:Class="Eule.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:Eule.App.Controls"
        xmlns:l="clr-namespace:Eule.App"
        Title="Eule"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource Eule.Font}">

    <!-- A tab glued to the right edge of the screen: rounded on the left, flat against the edge. -->
    <!-- Hugs the right edge and takes only the width it needs; any extra window width stays transparent (click-through). -->
    <Border x:Name="Card" Margin="18,16,0,16" CornerRadius="30,0,0,30" Padding="7,7,10,7" HorizontalAlignment="Right"
            Background="{DynamicResource Eule.Raised}" BorderBrush="{DynamicResource Eule.Line}" BorderThickness="1,1,0,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="200"
                              Color="{DynamicResource Eule.ShadowColor}" Opacity="{DynamicResource Eule.ShadowOpacity}" />
        </Border.Effect>

        <StackPanel>
            <!-- Header: the owl, the clock (only close to the break), the two ways to take a note -->
            <StackPanel Orientation="Horizontal">
                <c:OwlView x:Name="Owl" Width="46" Height="46" Cursor="Hand" />

                <StackPanel x:Name="TimeBlock" Margin="10,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="Caption" Style="{StaticResource Eule.Caption}" />
                    <TextBlock x:Name="Time" Style="{StaticResource Eule.Clock}" FontSize="22" Margin="0,-3,0,0" />
                </StackPanel>

                <StackPanel x:Name="ModeButtons" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="KeyboardButton" Style="{StaticResource Eule.ModeButton}" Content="&#xE765;"
                            ToolTip="{l:T asst.keyboard}" />
                    <Button x:Name="MicButton" Style="{StaticResource Eule.ModeButton}" Content="&#xE720;"
                            ToolTip="{l:T asst.mic}" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Everything below opens inside the same frame. -->
            <Grid x:Name="Body" Width="300" HorizontalAlignment="Left" Margin="4,10,0,2" Visibility="Collapsed">

                <!-- Break prompt -->
                <StackPanel x:Name="PromptPanel" Visibility="Collapsed">
                    <TextBlock x:Name="PromptText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Eule.Ink}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="AcceptButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T widget.accept}" />
                        <Button x:Name="SnoozeButton" Style="{StaticResource Eule.Pill}" />
                        <Button x:Name="SkipButton" Style="{StaticResource Eule.Pill}" Content="{l:T widget.skip}" />
                        <Button x:Name="StartButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T widget.start}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Typing -->
                <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                    <ui:TextBox x:Name="InputBox" PlaceholderText="{l:T note.placeholder}" ClearButtonEnabled="False"
                                MaxLength="2000" TextWrapping="Wrap" />
                    <DockPanel Margin="2,8,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Eule.PillPrimary}"
                                Content="{l:T note.send}" Margin="0" />
                        <TextBlock Text="Enter ↵  ·  Esc" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Eule.Muted}" />
                    </DockPanel>
                </StackPanel>

                <!-- Listening / understanding -->
                <StackPanel x:Name="ListenPanel" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource Eule.PillPrimary}"
                                Content="{l:T asst.stop}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="26" Margin="0,0,12,0" />
                        <TextBlock x:Name="ListenText" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource Eule.Ink}" />
                    </DockPanel>
                </StackPanel>

                <!-- One-time speech model download -->
                <StackPanel x:Name="DownloadPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DownloadText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Eule.Ink}" />
                    <ProgressBar x:Name="DownloadBar" Height="4" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" />
                    <WrapPanel x:Name="DownloadButtons" Margin="0,10,0,0">
                        <Button x:Name="DownloadButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T asst.download}" />
                        <Button x:Name="CancelDownloadButton" Style="{StaticResource Eule.Pill}" Content="{l:T asst.cancel}" />
                    </WrapPanel>
                </StackPanel>

                <!-- What Eule did -->
                <StackPanel x:Name="ReplyPanel" Visibility="Collapsed">
                    <TextBlock x:Name="HeardText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic"
                               Foreground="{DynamicResource Eule.Muted}" Visibility="Collapsed" />
                    <TextBlock x:Name="ReplyText" FontSize="13.5" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Eule.Ink}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="UndoButton" Style="{StaticResource Eule.Pill}" Content="{l:T note.undo}" Visibility="Collapsed" />
                        <Button x:Name="SignInButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T menu.signIn}" Visibility="Collapsed" />
                        <Button x:Name="PrivacyButton" Style="{StaticResource Eule.Pill}" Content="{l:T asst.openPrivacy}" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
