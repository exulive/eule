<Window x:Class="Eule.App.Views.NoteBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:Eule.App.Controls"
        xmlns:l="clr-namespace:Eule.App"
        Title="Eule" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="420"
        FontFamily="{StaticResource Eule.Font}">

    <Border x:Name="Card" Margin="16" CornerRadius="22" Padding="12,12,16,12"
            Background="{DynamicResource Eule.Raised}" BorderBrush="{DynamicResource Eule.Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270"
                              Color="{DynamicResource Eule.ShadowColor}" Opacity="{DynamicResource Eule.ShadowOpacity}" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <c:OwlView x:Name="Owl" Width="46" Height="46" VerticalAlignment="Top" ShowRing="False" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <!-- Typing -->
                <StackPanel x:Name="InputPanel">
                    <ui:TextBox x:Name="InputBox" PlaceholderText="{l:T note.placeholder}" ClearButtonEnabled="False"
                                MaxLength="2000" />
                    <DockPanel Margin="2,8,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Eule.PillPrimary}"
                                Content="{l:T note.send}" Margin="0" />
                        <TextBlock Text="Enter ↵  ·  Esc" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Eule.Muted}" />
                    </DockPanel>
                </StackPanel>

                <!-- Answer -->
                <StackPanel x:Name="ReplyPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ReplyText" FontSize="14" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource Eule.Ink}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="UndoButton" Style="{StaticResource Eule.Pill}" Content="{l:T note.undo}" Visibility="Collapsed" />
                        <Button x:Name="SignInButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T menu.signIn}" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
