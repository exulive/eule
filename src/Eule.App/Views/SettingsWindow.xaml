<ui:FluentWindow x:Class="Eule.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:Eule.App.Controls"
                 xmlns:l="clr-namespace:Eule.App"
                 Title="{l:T set.title}" Width="560" Height="780" MinWidth="460" MinHeight="420"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round" FontFamily="{StaticResource Eule.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{l:T set.title}" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
            <StackPanel>

                <!-- Header -->
                <DockPanel Margin="0,8,0,0">
                    <c:OwlView x:Name="Owl" Width="58" Height="58" DockPanel.Dock="Left" />
                    <ui:Button x:Name="StatsButton" DockPanel.Dock="Right" VerticalAlignment="Center" Appearance="Secondary"
                               Content="{l:T set.stats}" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Eule" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Eule.Ink}" />
                        <TextBlock x:Name="TodayText" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Eule.Muted}" />
                    </StackPanel>
                </DockPanel>

                <!-- Rhythm -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.rhythm}" />
                <WrapPanel x:Name="Presets" Margin="0,0,0,8">
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="30,5" Content="{l:T set.preset.30}" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="60,10" Content="{l:T set.preset.60}" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="25,5" Content="{l:T set.preset.25}" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="45,15" Content="45 · 15" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="50,10" Content="50 · 10" />
                </WrapPanel>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="WorkBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="240"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.work}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.workDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="BreakBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="60"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.break}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.minutes}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="GoalBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="20"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.goal}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.goalDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Reminder level -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.level}" />
                <StackPanel x:Name="Levels">
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Gentle">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.gentle}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.gentleDesc}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Balanced">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.balanced}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.balancedDesc}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Firm">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.firm}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.firmDesc}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Strict">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.strict}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.strictDesc}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border x:Name="EmergencyRow" Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="EmergencySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.emergency}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.emergencyDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="SnoozeRow" Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:NumberBox x:Name="SnoozeBox" Width="112" Minimum="1" Maximum="60" SmallChange="1"
                                          MaxDecimalPlaces="0" ClearButtonEnabled="False" ToolTip="{l:T set.snoozeTip}" />
                            <ui:NumberBox x:Name="MaxSnoozeBox" Width="112" Margin="8,0,0,0" Minimum="0" Maximum="10" SmallChange="1"
                                          MaxDecimalPlaces="0" ClearButtonEnabled="False" ToolTip="{l:T set.maxSnoozeTip}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.snooze}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.snoozeDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="WarnBox" DockPanel.Dock="Right" Width="132" Minimum="0" Maximum="600"
                                      SmallChange="15" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.warn}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.warnDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="BusySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.busy}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.busyDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Behaviour -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.behaviour}" />
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="AwaySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.away}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.awayDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="AutoRestartSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.autoRestart}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.autoRestartDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="EyeSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.eye}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.eyeDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="CoverSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.cover}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.coverDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="SoundSwitch" DockPanel.Dock="Right" />
                        <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.sound}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="WidgetSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.widget}" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.widgetDesc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="StartupSwitch" DockPanel.Dock="Right" />
                        <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.startup}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Work hours -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.hours}" />
                <Border Style="{StaticResource Eule.Row}">
                    <StackPanel>
                        <DockPanel>
                            <ui:ToggleSwitch x:Name="HoursSwitch" DockPanel.Dock="Right" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Eule.RowTitle}" Text="{l:T set.hoursOnly}" />
                                <TextBlock Style="{StaticResource Eule.RowDesc}" Text="{l:T set.hoursDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="HoursPanel" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="HoursStart" Width="92" MaxLength="5" ClearButtonEnabled="False" />
                                <TextBlock Text="–" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Eule.Muted}" />
                                <ui:TextBox x:Name="HoursEnd" Width="92" MaxLength="5" ClearButtonEnabled="False" />
                            </StackPanel>
                            <WrapPanel x:Name="Days" Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.look}" />
                <WrapPanel x:Name="Themes">
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="System" Content="{l:T set.theme.system}" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="Light" Content="{l:T set.theme.light}" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="Dark" Content="{l:T set.theme.dark}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.language}" Margin="2,16,0,10" />
                <WrapPanel x:Name="Languages">
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="tr" Content="Türkçe" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="en" Content="English" />
                </WrapPanel>
                <DockPanel x:Name="RestartRow" Visibility="Collapsed" Margin="2,4,0,0">
                    <ui:Button x:Name="RestartButton" DockPanel.Dock="Right" Appearance="Primary" Content="{l:T set.restart}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Eule.Muted}"
                               Text="{l:T set.languageRestart}" TextWrapping="Wrap" />
                </DockPanel>

                <!-- About -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="{l:T set.about}" />
                <Border Style="{StaticResource Eule.Row}">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button x:Name="UpdateButton" DockPanel.Dock="Right" Appearance="Secondary" Content="{l:T set.checkUpdate}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="VersionText" Style="{StaticResource Eule.RowTitle}" />
                                <TextBlock x:Name="UpdateText" Style="{StaticResource Eule.RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Eule.RowDesc}" Margin="0,12,0,0" Text="{l:T set.privacy}" />
                    </StackPanel>
                </Border>
                <ui:Button x:Name="OpenFolder" Margin="0,4,0,0" HorizontalAlignment="Left" Appearance="Transparent" Content="{l:T set.folder}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
