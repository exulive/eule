<ui:FluentWindow x:Class="Eule.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:Eule.App.Controls"
                 Title="Eule · Ayarlar" Width="560" Height="780" MinWidth="460" MinHeight="420"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round" FontFamily="{StaticResource Eule.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Ayarlar" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
            <StackPanel>

                <!-- Header -->
                <DockPanel Margin="0,8,0,0">
                    <c:OwlView x:Name="Owl" Width="58" Height="58" DockPanel.Dock="Left" />
                    <ui:Button x:Name="StatsButton" DockPanel.Dock="Right" VerticalAlignment="Center" Appearance="Secondary"
                               Content="İstatistik" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Eule" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Eule.Ink}" />
                        <TextBlock x:Name="TodayText" FontSize="12.5" Foreground="{DynamicResource Eule.Muted}" />
                    </StackPanel>
                </DockPanel>

                <!-- Rhythm -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Ritim" />
                <WrapPanel x:Name="Presets" Margin="0,0,0,8">
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="30,5" Content="30 dk · 5 dk mola" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="60,10" Content="Saatte bir · 10 dk" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="25,5" Content="Pomodoro 25 · 5" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="45,15" Content="45 · 15" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="50,10" Content="50 · 10" />
                </WrapPanel>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="WorkBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="240"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Oturma süresi" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Kaç dakikada bir kalkmak istersin?" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="BreakBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="60"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Mola süresi" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Dakika" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="GoalBox" DockPanel.Dock="Right" Width="132" Minimum="1" Maximum="20"
                                      SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Günlük mola hedefi" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Hedefe ulaştığın günler seriye eklenir. Bilgisayar başında olmadığın günler seriyi bozmaz." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Reminder level -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Hatırlatma biçimi" />
                <StackPanel x:Name="Levels">
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Gentle">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Nazik" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Eule sadece köşeden seslenir, cevap verene kadar arada bir hatırlatır." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Balanced">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Dengeli" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Önce köşeden sorar; bir dakika içinde cevap gelmezse ya da erteleme hakkın biterse mola ekranı açılır." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Firm">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Kararlı" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Mola ekranı hemen açılır. Erteleyebilir ya da atlayabilirsin." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Eule.ChoiceCard}" GroupName="Level" Tag="Strict">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Zorunlu" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Ekran kararır ve mola bitene kadar açılmaz. Erteleme ya da atlama yok." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border x:Name="EmergencyRow" Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="EmergencySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Acil durum çıkışı" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Zorunlu molada Shift'i 10 saniye basılı tutarak çıkabilirsin. İstatistiğe 'bozuldu' olarak yazılır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="SnoozeRow" Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:NumberBox x:Name="SnoozeBox" Width="112" Minimum="1" Maximum="60" SmallChange="1"
                                          MaxDecimalPlaces="0" ClearButtonEnabled="False" ToolTip="Erteleme süresi (dk)" />
                            <ui:NumberBox x:Name="MaxSnoozeBox" Width="112" Margin="8,0,0,0" Minimum="0" Maximum="10" SmallChange="1"
                                          MaxDecimalPlaces="0" ClearButtonEnabled="False" ToolTip="Arka arkaya en fazla erteleme" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Erteleme" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Kaç dakika · en fazla kaç kez" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:NumberBox x:Name="WarnBox" DockPanel.Dock="Right" Width="132" Minimum="0" Maximum="600"
                                      SmallChange="15" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Önceden haber ver" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Saniye. Eule molaya bu kadar kala uyanıp sana bakar. 0 = kapalı." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="BusySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Meşgulken bekle" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Sunum, görüşme ya da tam ekran uygulama sırasında mola, bitene kadar bekler." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Behaviour -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Davranış" />
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="AwaySwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Masadan kalkmak mola sayılsın" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Mola süresi kadar bilgisayara dokunmazsan sayaç baştan başlar." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="AutoRestartSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Mola bitince kendiliğinden devam et" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Kapalıysa sayaç sen 'Devam et' diyene kadar bekler." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="EyeSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Göz molası (20-20-20)" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="20 dakikada bir, ekranın üstünde 20 saniyelik küçük bir hatırlatma. Tıklamaları engellemez." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="CoverSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Molada tüm ekranları kapla" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Birden fazla monitörün varsa. Zorunlu molada her zaman açıktır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="SoundSwitch" DockPanel.Dock="Right" />
                        <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Ses" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="WidgetSwitch" DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Eule köşede dursun" />
                            <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Kapalıyken yalnızca görev çubuğu simgesi kalır." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Eule.Row}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="StartupSwitch" DockPanel.Dock="Right" />
                        <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Windows açılınca başlat" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Work hours -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Mesai saatleri" />
                <Border Style="{StaticResource Eule.Row}">
                    <StackPanel>
                        <DockPanel>
                            <ui:ToggleSwitch x:Name="HoursSwitch" DockPanel.Dock="Right" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Eule.RowTitle}" Text="Sadece mesai saatlerinde hatırlat" />
                                <TextBlock Style="{StaticResource Eule.RowDesc}" Text="Dışında Eule sessizce uyur." />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="HoursPanel" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="HoursStart" Width="92" MaxLength="5" ClearButtonEnabled="False" />
                                <TextBlock Text="–" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Eule.Muted}" />
                                <ui:TextBox x:Name="HoursEnd" Width="92" MaxLength="5" ClearButtonEnabled="False" />
                            </StackPanel>
                            <WrapPanel x:Name="Days" Margin="0,12,0,0">
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="1" Content="Pzt" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="2" Content="Sal" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="3" Content="Çar" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="4" Content="Per" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="5" Content="Cum" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="6" Content="Cmt" />
                                <ToggleButton Style="{StaticResource Eule.Chip}" Tag="0" Content="Paz" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Style="{StaticResource Eule.SectionTitle}" Text="Görünüm" />
                <WrapPanel x:Name="Themes">
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="System" Content="Sistem" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="Light" Content="Açık" />
                    <ToggleButton Style="{StaticResource Eule.Chip}" Tag="Dark" Content="Koyu" />
                </WrapPanel>

                <!-- Footer -->
                <DockPanel Margin="2,28,0,0">
                    <ui:Button x:Name="OpenFolder" DockPanel.Dock="Right" Appearance="Transparent" Content="Veri klasörü" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Eule.Muted}" TextWrapping="Wrap"
                               Text="Eule ücretsizdir. Verilerin yalnızca bu bilgisayarda kalır, hiçbir yere gönderilmez." />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
