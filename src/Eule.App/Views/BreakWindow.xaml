<Window x:Class="Eule.App.Views.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Eule.App.Controls"
        Title="Eule · Mola"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="True" Background="{DynamicResource Eule.Overlay}" Opacity="0"
        FontFamily="{StaticResource Eule.Font}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <c:OwlView x:Name="Owl" Width="176" Height="176" Mood="Sleeping" HorizontalAlignment="Center" />

            <TextBlock x:Name="Heading" Text="Kalkma zamanı" FontSize="34" FontWeight="Light" Margin="0,30,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Eule.Ink}" />
            <TextBlock x:Name="Tip" FontSize="16" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Eule.Muted}" />
            <TextBlock x:Name="Time" Style="{StaticResource Eule.Clock}" FontSize="68" Margin="0,22,0,0"
                       HorizontalAlignment="Center" />

            <WrapPanel x:Name="Buttons" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button x:Name="SnoozeButton" Style="{StaticResource Eule.Pill}" Content="5 dk ertele" FontSize="14" Padding="18,8" />
                <Button x:Name="SkipButton" Style="{StaticResource Eule.Pill}" Content="Molayı atla" FontSize="14" Padding="18,8" />
                <Button x:Name="StartButton" Style="{StaticResource Eule.PillPrimary}" Content="Çalışmaya başla" FontSize="14" Padding="22,9" />
            </WrapPanel>

            <!-- Strict mode: only the emergency exit. -->
            <StackPanel x:Name="Emergency" Margin="0,30,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Acil bir durum mu var? Shift tuşunu 10 saniye basılı tut." FontSize="12.5"
                           Foreground="{DynamicResource Eule.Muted}" HorizontalAlignment="Center" />
                <Border Height="3" Width="220" Margin="0,10,0,0" CornerRadius="1.5" Background="{DynamicResource Eule.Track}">
                    <Border x:Name="EmergencyFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5"
                            Background="{DynamicResource Eule.Warn}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
