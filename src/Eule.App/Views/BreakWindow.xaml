<Window x:Class="Eule.App.Views.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Eule.App.Controls"
        xmlns:l="clr-namespace:Eule.App"
        Title="{l:T break.windowTitle}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" Background="{DynamicResource Eule.Overlay}" Opacity="0"
        FontFamily="{StaticResource Eule.Font}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">

            <!-- Owl with a breathing halo: grow = breathe in, shrink = breathe out. -->
            <Grid Width="232" Height="232" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" StrokeThickness="1.5" Stroke="{DynamicResource Eule.Break}" Opacity="0.45"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="HaloScale" ScaleX="0.8" ScaleY="0.8" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <c:OwlView x:Name="Owl" Width="164" Height="164" Mood="Sleeping" />
            </Grid>
            <TextBlock x:Name="BreathText" Text="{l:T break.breatheIn}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource Eule.Muted}" />

            <TextBlock x:Name="Heading" Text="{l:T break.title}" FontSize="34" FontWeight="Light" Margin="0,22,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Eule.Ink}" />
            <TextBlock x:Name="Sub" FontSize="15" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Eule.Muted}" Visibility="Collapsed" />

            <!-- One small movement at a time. -->
            <Border x:Name="ExerciseCard" Margin="0,24,0,0" Padding="22,16" CornerRadius="14" Width="440"
                    Background="{DynamicResource Eule.Raised}" BorderBrush="{DynamicResource Eule.Line}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <StackPanel x:Name="ExerciseDots" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExerciseTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Eule.Ink}" />
                    </DockPanel>
                    <TextBlock x:Name="ExerciseText" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource Eule.Muted}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Time" Style="{StaticResource Eule.Clock}" FontSize="60" Margin="0,22,0,0"
                       HorizontalAlignment="Center" />

            <WrapPanel x:Name="Buttons" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="SnoozeButton" Style="{StaticResource Eule.Pill}" FontSize="14" Padding="18,8" />
                <Button x:Name="SkipButton" Style="{StaticResource Eule.Pill}" Content="{l:T break.skip}" FontSize="14" Padding="18,8" />
                <Button x:Name="StartButton" Style="{StaticResource Eule.PillPrimary}" Content="{l:T break.start}" FontSize="14" Padding="22,9" />
            </WrapPanel>

            <!-- Strict mode: only the emergency exit. -->
            <StackPanel x:Name="Emergency" Margin="0,26,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{l:T break.emergency}" FontSize="12.5"
                           Foreground="{DynamicResource Eule.Muted}" HorizontalAlignment="Center" />
                <Border Height="3" Width="220" Margin="0,10,0,0" CornerRadius="1.5" Background="{DynamicResource Eule.Track}">
                    <Border x:Name="EmergencyFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5"
                            Background="{DynamicResource Eule.Warn}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
